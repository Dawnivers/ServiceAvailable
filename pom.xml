<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <!-- ① 身份：Boot 认这两个坐标来决定父 pom -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>          <!-- 3.5 线最新，已在 D:\m2repo 预热 -->
    <relativePath/>
  </parent>
  <groupId>com.dawnivers</groupId>
  <artifactId>be</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <!-- ② 编译级别：JDK17 是你 D:\java 的版本 -->
  <properties>
    <java.version>17</java.version>
  </properties>

  <!-- ③ 依赖：三个就够今天用，别一次堆满 -->
  <dependencies>
    <dependency>                      <!-- REST / 内置 Tomcat -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>                      <!-- JdbcTemplate（不是 MyBatis，D6 再说） -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>                      <!-- PG 驱动，runtime 即可 -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>